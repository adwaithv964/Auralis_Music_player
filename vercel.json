{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "regions": ["bom1"],
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "https://auralis-music-player-ta1r.onrender.com/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://auralis-music-player-ta1r.onrender.com/readyz"
    },
    {
      "source": "/api/saavn-india-gateway",
      "destination": "/api/saavn-india-gateway"
    },
    {
      "source": "/api/:path*",
      "destination": "https://auralis-music-player-ta1r.onrender.com/api/:path*"
    }
  ]
}
